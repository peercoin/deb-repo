# Loaded by pbuilder (Bash). Select a target with OS, DIST and ARCH.
case "${OS:-}:${DIST:-}:${ARCH:-}" in
    debian:trixie:amd64|debian:trixie:arm64|debian:trixie:riscv64|debian:bookworm:amd64|debian:bookworm:arm64|debian:bookworm:i386|debian:bullseye:amd64)
        MIRRORSITE=https://deb.debian.org/debian
        COMPONENTS="main contrib non-free"
        ;;
    raspbian:buster:armhf)
        MIRRORSITE=https://legacy.raspbian.org/raspbian
        COMPONENTS="main contrib non-free"
        ;;
    raspbian:trixie:armhf|raspbian:bookworm:armhf|raspbian:bullseye:armhf)
        MIRRORSITE=https://archive.raspbian.org/raspbian
        COMPONENTS="main contrib non-free"
        ;;
    ubuntu:jammy:riscv64)
        MIRRORSITE=https://ports.ubuntu.com/ubuntu-ports
        COMPONENTS="main restricted universe multiverse"
        ;;
    *)
        echo "Unsupported build target: OS=${OS:-} DIST=${DIST:-} ARCH=${ARCH:-}" >&2
        exit 1
        ;;
esac

NAME="$OS-$DIST-$ARCH"
BASETGZ="/var/cache/pbuilder/$NAME-base.tgz"
DISTRIBUTION="$DIST"
ARCHITECTURE="$ARCH"
BUILDPLACE=/var/cache/pbuilder/build
APTCACHE="/var/cache/pbuilder/$NAME/aptcache"
# CI keeps these files in the workspace so Actions can restore and save them.
if [[ -n ${PBUILDER_CACHE_DIR:-} ]]; then
    BASETGZ="$PBUILDER_CACHE_DIR/base.tgz"
    APTCACHE="$PBUILDER_CACHE_DIR/aptcache"
    CCACHEDIR="$PBUILDER_CACHE_DIR/ccache"
fi
BUILDRESULT="/var/cache/pbuilder/result/$NAME"
PBUILDERSATISFYDEPENDSCMD=/usr/lib/pbuilder/pbuilder-satisfydepends-apt
# Configure APT inside the chroot, including the separate dependency resolver.
APTCONFDIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/apt" && pwd)"
export DEB_BUILD_OPTIONS="parallel=${BUILD_JOBS:-8}"

# CI supplies a verified archive key when creating a fresh chroot.
if [[ -n ${PBUILDER_KEYRING:-} ]]; then
    DEBOOTSTRAPOPTS=(--variant=buildd --include=apt,ca-certificates --force-check-gpg --keyring "$PBUILDER_KEYRING")
    APTKEYRINGS=("$PBUILDER_KEYRING")
    EXTRAPACKAGES="ca-certificates"
fi
